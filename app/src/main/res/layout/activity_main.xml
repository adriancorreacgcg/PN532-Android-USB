<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PN532 USB Reader"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#14253B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Elechouse PN532 V3 · HSU/UART · CP210x · 115200"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:padding="12dp"
            android:background="#E3EAF1"
            android:textColor="#14253B"
            android:text="Sin conexión USB"
            android:textSize="16sp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Conectar / desconectar USB" />

        <Button
            android:id="@+id/firmwareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Consultar firmware" />

        <Button
            android:id="@+id/initButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Inicializar PN532" />

        <Button
            android:id="@+id/readButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Leer tarjeta NFC" />

        <TextView
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#E6F5EC"
            android:textColor="#193B2B"
            android:textSize="15sp"
            android:textIsSelectable="true"
            android:text="Sin tarjeta detectada" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Registro HEX (TX / RX)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#14253B" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#17212F"
            android:textColor="#CCF2D8"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:minHeight="200dp"
            android:text="Conecta el adaptador CP210x mediante OTG.\n" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Borrar registro" />

    </LinearLayout>
</ScrollView>
